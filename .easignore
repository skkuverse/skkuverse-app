# =============================================================================
# .easignore — EAS build ignore (replaces .gitignore during archive)
#
# Same as .gitignore, except the Firebase config files stay in the build:
#   - GoogleService-Info.plist (iOS)
#   - google-services.json (Android)
# =============================================================================

# === From root .gitignore ===

# Dependencies
node_modules/

# Expo
.expo/
dist/

# Local agent state: session worktrees under .claude/worktrees/ are whole
# checkouts (GBs with their node_modules), and none of .claude/ is a build input.
.claude/

# Native builds (CNG — regenerated by expo prebuild)
ios/
android/

# Local, maintainer-only env files that can hold credentials, never archived; never narrow these.
# `.env.example` is a committed placeholder and stays.
.env
.env.local
.env.*.local
# hot-updater's local CLI config (apps/mobile/.env.hotupdater): maintainer-only,
# never a build input.
.env.hotupdater

# Firebase credentials — needed by the build, so not excluded here
# GoogleService-Info.plist
# google-services.json

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Build
*.tsbuildinfo

# Turborepo
.turbo/

# === From apps/mobile/.gitignore ===

# Expo
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

*.pem
# The hot-updater public key the @hot-updater/expo plugin embeds at prebuild;
# without it prebuild fails.
!apps/mobile/keys/hot-updater-public.pem

# EAS local credentials
credentials.json

app-example
