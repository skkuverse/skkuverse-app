# Dependencies
node_modules/

# Expo
.expo/
dist/

# Native builds (CNG — regenerated by expo prebuild)
ios/
android/

# Environment: local, maintainer-only files that can hold credentials, kept out of the repo.
# `.env.*` catches every sidecar file; never narrow it.
# `.env.example` is the schema, carries no values, and is tracked on purpose.
.env
.env.*
!.env.example
.envrc

# Firebase credentials
GoogleService-Info.plist
google-services.json

# Build artifacts
build.ipa
*.apk

# Signing keys and store credentials. The OTA public key is the one tracked
# exception: the @hot-updater/expo plugin embeds it at prebuild.
*.p8
*.p12
*.jks
*.mobileprovision
*.pem
!apps/mobile/keys/hot-updater-public.pem
credentials.json
play-store-key.json
*service-account*.json
CLAUDE-SECURITY-*/

# IDE
.vscode/settings.json
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# The backup BSD `sed -i -E` leaves when -E is read as the -i suffix.
*-E

# Build
*.tsbuildinfo

# Turborepo (future)
.turbo/

# Firebase CLI / Emulator
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
firestore-export/

# Claude Code — allow only workflow files, CODEOWNERS and dependabot.yml.
# ⚠️ This is an allowlist: a new workflow file is silently untracked until it
#    gets a `!` line here. `git add` reports nothing and CI never runs it.
#    Verify with: git check-ignore -v .github/workflows/<name>.yml
.github/*
!.github/CODEOWNERS
!.github/dependabot.yml
!.github/workflows/
.github/workflows/*
!.github/workflows/ci.yml
!.github/workflows/claude.yml
!.github/workflows/contracts-sync.yml
!.github/workflows/back-merge-dev.yml

# Claude Code local state (per-machine: scheduled-task locks, settings).
# Project-level CLAUDE.md and any docs/plans intentionally live at the
# repo root, NOT inside this directory.
# ⚠️ An allowlist, like .github/ above: only the UI rules file, the `sds` skill and the
#    `verify-mobile` skill are tracked, so every agent working on UI gets them. Anything else
#    in .claude/ stays local. Verify with: git check-ignore -v .claude/<path>
.claude/*
!.claude/rules/
!.claude/skills/
.claude/skills/*
!.claude/skills/sds/
!.claude/skills/verify-mobile/

# verify-mobile evidence: screenshots, console dumps and notes from a verification run
.verify/

# Local MCP config: maintainer-only, never committed
.mcp.json

# explain-diff plugin output — generated HTML walkthroughs, regenerable
explain-diff/

# Local, maintainer-only notes. Outside the docs conventions (language,
# frontmatter) on purpose; never committed.
docs/private/
