{
  "name": "mobile",
  "main": "./index.ts",
  "version": "1.0.0",
  "scripts": {
    "start": "node ../../scripts/check-patches.mjs && EXPO_UNSTABLE_BONJOUR=0 NODE_OPTIONS=\"$NODE_OPTIONS --dns-result-order=ipv4first\" expo start --localhost",
    "start:lan": "node ../../scripts/check-patches.mjs && EXPO_UNSTABLE_BONJOUR=0 expo start --lan",
    "android": "node ../../scripts/check-patches.mjs && expo run:android --no-bundler",
    "ios": "node ../../scripts/check-patches.mjs && expo run:ios --no-bundler",
    "web": "EXPO_UNSTABLE_BONJOUR=0 expo start --web --localhost",
    "lint": "yarn --cwd ../.. lint",
    "test": "node --experimental-strip-types --test 'src/**/*.test.mts' 'scripts/**/*.test.mjs' && vitest run",
    "licenses:generate": "node scripts/generate-oss-licenses.mjs"
  },
  "dependencies": {
